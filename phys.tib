Define LibPub main()=
Prgm
©phys\main(): Y&F ch21-23 solver
Local ch,t,a,nt,quit
setMode({2,2,3,1,4,1,5,1})
physok:=1
Disp "PHYSICS SOLVER Y&F 21-23"
Disp "Blank or Cancel = back/quit"
Disp "Units: 2nC, 1cm; or 2E-9"
quit:=0
Loop
  Disp "CHAPTERS:"
  Disp " 21 Coulomb's law"
  Disp " 22 Gauss's law"
  Disp " 23 Electric potential"
  Loop
    phys\ask("Chapter 21, 22 or 23 (0=quit)",0)
    If physok=0 Then
      ch:=0
      Exit
    EndIf
    ch:=physv
    If ch=1 or ch=2 or ch=3 Then
      ch:=ch+20
    EndIf
    If ch=0 or ch=21 or ch=22 or ch=23 Then
      Exit
    EndIf
    Text "Type 21, 22 or 23 (0 quits)"
  EndLoop
  If ch=0 Then
    Exit
  EndIf
  Loop
    If ch=21 Then
      nt:=6
      Disp "CH 21 COULOMB TYPES:"
      Disp " 1 Charge count Q=Ne"
      Disp " 2 Force, 2 charges"
      Disp " 3 Net force, 1D line"
      Disp " 4 Net force, 2D (x,y)"
      Disp " 5 Zero-force point"
      Disp " 6 Hanging spheres"
    ElseIf ch=22 Then
      nt:=7
      Disp "CH 22 GAUSS TYPES:"
      Disp " 1 Flux, flat surface"
      Disp " 2 Flux from Q enclosed"
      Disp " 3 Line charge/cylinder"
      Disp " 4 Sphere: E at radius r"
      Disp " 5 Force from a shell"
      Disp " 6 Charge densities"
      Disp " 7 Coaxial cable"
    Else
      nt:=10
      Disp "CH 23 POTENTIAL TYPES:"
      Disp " 1 U of point charges"
      Disp " 2 V at a point, work"
      Disp " 3 Work-energy, uniform E"
      Disp " 4 Accelerate/stop e,p"
      Disp " 5 Point q from V and E"
      Disp " 6 Line charge potential"
      Disp " 7 E from V(x,y,z)"
      Disp " 8 Spheres/cylinders Vab"
      Disp " 9 Insulating sphere V"
      Disp " 10 Where U = 0 on a line"
    EndIf
    phys\ask("Type 1-"&string(nt)&" (0=back)",200+nt)
    If physok=0 Then
      physok:=1
      Exit
    EndIf
    t:=physv
    If t=0 Then
      Exit
    EndIf
    Loop
      physok:=1
      If ch=21 Then
        If t=1 Then
          phys\m211()
        ElseIf t=2 Then
          phys\m212()
        ElseIf t=3 Then
          phys\m213()
        ElseIf t=4 Then
          phys\m214()
        ElseIf t=5 Then
          phys\m215()
        Else
          phys\m216()
        EndIf
      ElseIf ch=22 Then
        If t=1 Then
          phys\m221()
        ElseIf t=2 Then
          phys\m222()
        ElseIf t=3 Then
          phys\m223()
        ElseIf t=4 Then
          phys\m224(0)
        ElseIf t=5 Then
          phys\m225()
        ElseIf t=6 Then
          phys\m226()
        Else
          phys\m227()
        EndIf
      Else
        If t=1 Then
          phys\m231()
        ElseIf t=2 Then
          phys\m232()
        ElseIf t=3 Then
          phys\m233()
        ElseIf t=4 Then
          phys\m234()
        ElseIf t=5 Then
          phys\m235()
        ElseIf t=6 Then
          phys\m236()
        ElseIf t=7 Then
          phys\m237()
        ElseIf t=8 Then
          phys\m238()
        ElseIf t=9 Then
          phys\m239()
        Else
          phys\m2310()
        EndIf
      EndIf
      If physok=0 Then
        Disp "(cancelled)"
        physok:=1
        Exit
      EndIf
      phys\ask("1=solve again 2=menu 3=quit",103)
      If physok=0 Then
        quit:=1
        Exit
      EndIf
      a:=physv
      If a=3 Then
        quit:=1
        Exit
      ElseIf a=2 Then
        Exit
      EndIf
    EndLoop
    If quit=1 Then
      Exit
    EndIf
  EndLoop
  If quit=1 Then
    Exit
  EndIf
EndLoop
DelVar physv,physok
Disp "Done."
EndPrgm

Define LibPriv fmt(x,n,z)=
Func
Local a,b,p,m,r,d,s,k,mt,ex
a:=approx(x)
If a=0 Then
  Return "0"
EndIf
b:=abs(a)
p:=0
While b≥10
  b:=b/10
  p:=p+1
EndWhile
While b<1
  b:=b*10
  p:=p-1
EndWhile
m:=round(sign(a)*b*10^(n-1),0)
If abs(m)≥10^n Then
  p:=p+1
  m:=m/10
EndIf
If p≥−3 and p≤2 Then
  r:=m*10^(p-n+1)
  d:=n-1-p
  If d<0 Then
    d:=0
  EndIf
  s:=format(r,"F"&string(d))
  If right(s,1)="." Then
    s:=left(s,dim(s)-1)
  EndIf
Else
  s:=format(a,"S"&string(n-1))
EndIf
If z=1 Then
  k:=inString(s,"ᴇ")
  If k>0 Then
    mt:=left(s,k-1)
    ex:=mid(s,k)
  Else
    mt:=s
    ex:=""
  EndIf
  If inString(mt,".")>0 Then
    While right(mt,1)="0"
      mt:=left(mt,dim(mt)-1)
    EndWhile
    If right(mt,1)="." Then
      mt:=left(mt,dim(mt)-1)
    EndIf
  EndIf
  s:=mt&ex
EndIf
Return s
EndFunc

Define LibPriv sf(x)=
Func
Return phys\fmt(x,3,0)
EndFunc

Define LibPriv sn(x)=
Func
Return phys\fmt(x,4,1)
EndFunc

Define LibPriv lc(c)=
Func
Local k
k:=inString("ABCDEFGHIJKLMNOPQRSTUVWXYZ",c)
If k>0 Then
  Return mid("abcdefghijklmnopqrstuvwxyz",k,1)
EndIf
Return c
EndFunc

Define LibPriv neg(s)=
Func
Local i,c,pc,w
w:=""
pc:="("
For i,1,dim(s)
  c:=mid(s,i,1)
  If c="-" and inString("(,{[+-−^*/ᴇ=<>≤≥≠",pc)>0 Then
    c:="−"
  EndIf
  If c="+" and inString("(,{[+-−^*/ᴇ=<>≤≥≠",pc)>0 Then
    c:=""
  EndIf
  w:=w&c
  If c≠" " and c≠"" Then
    pc:=c
  EndIf
EndFor
Return w
EndFunc

Define LibPriv num(s)=
Func
Local t,i,c,n,l1,l2,body,mult,dg
dg:="0123456789."
t:=""
For i,1,dim(s)
  c:=mid(s,i,1)
  If c≠" " Then
    t:=t&c
  EndIf
EndFor
n:=dim(t)
If n=0 Then
  Return ""
EndIf
body:=t
mult:=""
l1:=phys\lc(right(t,1))
If n≥3 Then
  l2:=phys\lc(mid(t,n-1,1))&l1
  If inString(dg&")",mid(t,n-2,1))>0 Then
    If l2="cm" Then
      mult:="1ᴇ−2"
    ElseIf l2="mm" or l2="mc" Then
      mult:="1ᴇ−3"
    ElseIf l2="um" or l2="µm" or l2="μm" or l2="uc" or l2="µc" or l2="μc" Then
      mult:="1ᴇ−6"
    ElseIf l2="nm" or l2="nc" Then
      mult:="1ᴇ−9"
    ElseIf l2="pc" Then
      mult:="1ᴇ−12"
    EndIf
    If mult≠"" Then
      body:=left(t,n-2)
    EndIf
  EndIf
EndIf
If mult="" and n≥2 Then
  If inString(dg&")",mid(t,n-1,1))>0 Then
    If l1="u" or l1="µ" or l1="μ" Then
      mult:="1ᴇ−6"
    ElseIf l1="n" Then
      mult:="1ᴇ−9"
    ElseIf l1="p" Then
      mult:="1ᴇ−12"
    ElseIf l1="k" Then
      mult:="1ᴇ3"
    ElseIf l1="m" or l1="c" Then
      mult:="1"
    EndIf
    If mult≠"" Then
      body:=left(t,n-1)
    EndIf
  EndIf
EndIf
If mult="" or mult="1" Then
  t:=body
Else
  t:="("&body&")*"&mult
EndIf
Return phys\expo(t)
EndFunc

Define LibPriv expo(t)=
Func
Local u,n,i,c,pc,nc
u:=""
n:=dim(t)
For i,1,n
  c:=mid(t,i,1)
  If (c="E" or c="e") and i>1 and i<n Then
    pc:=mid(t,i-1,1)
    nc:=mid(t,i+1,1)
    If inString("0123456789.",pc)>0 and inString("0123456789+-−",nc)>0 Then
      c:="ᴇ"
    EndIf
  EndIf
  u:=u&c
EndFor
Return phys\neg(u)
EndFunc

Define LibPriv ask(pr,code)=
Prgm
Local s,t,v,k,nn,msg
setMode({2,2,3,1,4,1,5,1})
If getType(physok)="NONE" Then
  physok:=1
EndIf
If physok=0 Then
  physv:=0
  Return
EndIf
Loop
  s:="@@"
  RequestStr pr,s,0
  If s="@@" or s="" Then
    physok:=0
    physv:=0
    Return
  EndIf
  t:=phys\num(s)
  If t="" Then
    physok:=0
    physv:=0
    Return
  EndIf
  Try
    v:=approx(expr(t))
  Else
    v:="bad"
    ClrErr
  EndTry
  If getType(v)≠"NUM" Then
    Text "Not a number. Try 2.5E-6 or 4n or 1.5cm"
    Cycle
  EndIf
  msg:=""
  If code=1 and v≤0 Then
    msg:="Use a positive value for size, mass or distance."
  ElseIf code=2 and v<0 Then
    msg:="Use zero or a positive value."
  ElseIf code=3 and v=0 Then
    msg:="Zero makes this calculation undefined."
  ElseIf code=4 and (v≤0 or v≥90) Then
    msg:="Use 0 < angle < 90 deg; 90 needs infinite force."
  ElseIf code=5 and (v<0 or v>90) Then
    msg:="Angle from the plane or normal must be 0-90 deg."
  ElseIf code≥100 Then
    If code≥200 Then
      nn:=code-200
      k:=0
    Else
      nn:=code-100
      k:=1
    EndIf
    If v≠floor(v) or v<k or v>nn Then
      msg:="Type a whole number from "&string(k)&" to "&string(nn)
    EndIf
  EndIf
  If msg≠"" Then
    Text msg
    Cycle
  EndIf
  If code≥100 Then
    k:=0
    While k<v
      k:=k+1
    EndWhile
    v:=k
  EndIf
  physv:=v
  Return
EndLoop
EndPrgm

Define LibPriv hdr(s)=
Prgm
phys\out("== "&s&" ==")
EndPrgm

Define LibPriv pk(l)=
Prgm
Local i,s,w
s:="  "&l[1]
For i,2,dim(l)
  w:=l[i]
  If dim(s)+dim(w)≤28 Then
    s:=s&w
  Else
    phys\out(s)
    s:="    "&w
  EndIf
EndFor
phys\out(s)
EndPrgm

Define LibPriv out(s)=
Prgm
Local t
t:=s
While dim(t)>28
  Disp left(t,28)
  t:="    "&mid(t,29)
EndWhile
Disp t
EndPrgm

Define LibPriv unz(s)=
Func
Local t,k
t:=s
k:=inString(t,"phz")
While k>0
  t:=left(t,k-1)&mid(t,k+3)
  k:=inString(t,"phz")
EndWhile
Return t
EndFunc

Define LibPriv m211()=
Prgm
Local c,nn,z,q,dn,lt,qe
qe:=1.602ᴇ−19
phys\hdr("21.1 Charge count")
Disp "1 Q from N  2 N from n*L"
Disp "3 N from Q"
phys\ask("Find: 1 Q, 2 N=n*L, 3 N from Q",103)
c:=physv
If physok=0 Then
  Return
EndIf
If c=1 Then
  phys\ask("Number of particles N",2)
  nn:=physv
  phys\ask("Charge in e (-1 electron, +1 proton)",3)
  z:=physv
ElseIf c=2 Then
  phys\ask("Particles per meter n (1/m)",1)
  dn:=physv
  phys\ask("Length L (m)",1)
  lt:=physv
  phys\ask("Charge in e (-1 electron, +1 proton)",3)
  z:=physv
Else
  phys\ask("Total charge Q (C)",3)
  q:=physv
  phys\ask("Charge in e (-1 electron, +1 proton)",3)
  z:=physv
EndIf
If physok=0 Then
  Return
EndIf
Disp "GIVEN:"
phys\out("  z = "&phys\sn(z)&" in e")
Disp "  e = 1.602ᴇ−19 C"
If c=1 Then
  phys\out("  N = "&phys\sn(nn))
ElseIf c=2 Then
  phys\out("  n = "&phys\sn(dn)&" per m")
  phys\out("  L = "&phys\sn(lt)&" m")
  nn:=dn*lt
Else
  phys\out("  Q = "&phys\sn(q)&" C")
EndIf
Disp "STEP 1: Formula"
If c=2 Then
  Disp "  N = n*L"
EndIf
If c=1 or c=2 Then
  Disp "  Q = N*z*e"
Else
  Disp "  N = |Q/(z*e)|"
EndIf
Disp "STEP 2: Plug in"
If c=2 Then
  phys\pk({"N = ("&phys\sn(dn)&")","*("&phys\sn(lt)&")"})
EndIf
If c=1 or c=2 Then
  phys\pk({"Q = ("&phys\sn(nn)&")","*("&phys\sn(z)&")","*(1.602ᴇ−19)"})
  q:=nn*z*qe
Else
  phys\pk({"N = |("&phys\sn(q)&")","/(("&phys\sn(z)&")","*(1.602ᴇ−19))|"})
  nn:=abs(q/(z*qe))
EndIf
Disp "STEP 3: Answer"
If c=2 or c=3 Then
  phys\out("  N = "&phys\sf(nn))
  Disp "  (number of particles)"
EndIf
If c=1 or c=2 Then
  phys\out("  Q = "&phys\sf(q)&" C")
EndIf
Disp "DIRECTION:"
If c=3 and q*z<0 Then
  Disp "  Q and z have unlike signs."
  Disp "  Count uses |Q/(z*e)|."
ElseIf q>0 Then
  Disp "  Positive charge."
ElseIf q<0 Then
  Disp "  Negative charge."
Else
  Disp "  No particles: Q = 0."
EndIf
EndPrgm

Define LibPriv m212()=
Prgm
Local q1,q2,r,f,kc
kc:=8.99ᴇ9
phys\hdr("21.2 Force, 2 charges")
phys\ask("Charge q1 (C)",0)
q1:=physv
phys\ask("Charge q2 (C)",0)
q2:=physv
phys\ask("Separation r (m)",1)
r:=physv
If physok=0 Then
  Return
EndIf
Disp "GIVEN:"
phys\out("  q1 = "&phys\sn(q1)&" C")
phys\out("  q2 = "&phys\sn(q2)&" C")
phys\out("  r = "&phys\sn(r)&" m")
Disp "STEP 1: Formula"
Disp "  F = k|q1*q2|/r^2"
Disp "STEP 2: Plug in"
phys\pk({"F = (8.99ᴇ9)","|("&phys\sn(q1)&")","("&phys\sn(q2)&")|","/("&phys\sn(r)&")^2"})
f:=kc*abs(q1*q2)/r^2
Disp "STEP 3: Answer"
phys\out("  F = "&phys\sf(f)&" N")
If q1*q2>0 Then
  Disp "DIRECTION: repulsive"
  Disp "  (same signs push apart)"
ElseIf q1*q2<0 Then
  Disp "DIRECTION: attractive"
  Disp "  (opposite signs attract)"
Else
  Disp "DIRECTION: none"
  Disp "  A zero charge feels no F."
EndIf
EndPrgm

Define LibPriv m213()=
Prgm
Local n,i,si,ql,xl,q0,x0,kc,r,f,w,fs,fnet
kc:=8.99ᴇ9
phys\hdr("21.3 Net force 1D")
phys\ask("Number of source charges (1-3)",103)
n:=physv
If physok=0 Then
  Return
EndIf
ql:=newList(n)
xl:=newList(n)
For i,1,n
  si:=string(i)
  phys\ask("Charge q"&si&" (C)",0)
  ql[i]:=physv
  phys\ask("Position x"&si&" (m)",0)
  xl[i]:=physv
EndFor
phys\ask("Target charge q0 (C)",0)
q0:=physv
phys\ask("Target position x0 (m)",0)
x0:=physv
If physok=0 Then
  Return
EndIf
Disp "GIVEN:"
For i,1,n
  si:=string(i)
  phys\out("  q"&si&" = "&phys\sn(ql[i])&" C")
  phys\out("    at x"&si&" = "&phys\sn(xl[i])&" m")
EndFor
phys\out("  target q0 = "&phys\sn(q0)&" C")
phys\out("    at x0 = "&phys\sn(x0)&" m")
For i,1,n
  If xl[i]=x0 Then
    phys\out("q"&string(i)&" is AT the target:")
    Disp "  r = 0, force undefined."
    Disp "  Use different positions."
    Return
  EndIf
EndFor
Disp "STEP 1: Formula"
Disp "  Fi = k|qi*q0|/ri^2"
Disp "  ri = |x0 - xi|"
Disp "  Like signs push away;"
Disp "  unlike signs pull toward."
Disp "STEP 2: Plug in"
fnet:=0
For i,1,n
  si:=string(i)
  r:=abs(x0-xl[i])
  f:=kc*abs(ql[i]*q0)/r^2
  phys\out("q"&si&": r = "&phys\sn(r)&" m")
  phys\pk({"F"&si&" = (8.99ᴇ9)","|("&phys\sn(ql[i])&")","("&phys\sn(q0)&")|","/("&phys\sn(r)&")^2"})
  phys\out("  F"&si&" = "&phys\sf(f)&" N")
  If ql[i]*q0>0 Then
    w:=sign(x0-xl[i])
    phys\out("  repel: away from q"&si)
  ElseIf ql[i]*q0<0 Then
    w:=sign(xl[i]-x0)
    phys\out("  attract: toward q"&si)
  Else
    w:=0
    Disp "  zero charge: no force"
  EndIf
  fs:=w*f
  If w>0 Then
    phys\out("  F"&si&"x = +"&phys\sf(f)&" N (+x)")
  ElseIf w<0 Then
    phys\out("  F"&si&"x = "&phys\sf(fs)&" N (−x)")
  EndIf
  fnet:=fnet+fs
EndFor
Disp "STEP 3: Answer"
Disp "  Fnet = sum of Fix"
phys\out("  Fnet = "&phys\sf(fnet)&" N")
If fnet>0 Then
  Disp "DIRECTION: +x"
ElseIf fnet<0 Then
  Disp "DIRECTION: −x"
Else
  Disp "DIRECTION: none (net 0)"
EndIf
EndPrgm

Define LibPriv m214()=
Prgm
Local n,i,si,ql,xl,yl,q0,x0,y0,kc,dx,dy,r,f,s,ux,uy,fx,fy,sx,sy,fm,ang,std,w1,w2
kc:=8.99ᴇ9
setMode({2,2,3,1,4,1,5,1})
phys\hdr("21.4 Net force 2D")
phys\ask("Number of source charges (1-3)",103)
n:=physv
If physok=0 Then
  Return
EndIf
ql:=newList(n)
xl:=newList(n)
yl:=newList(n)
For i,1,n
  si:=string(i)
  phys\ask("Charge q"&si&" (C)",0)
  ql[i]:=physv
  phys\ask("Position x"&si&" (m)",0)
  xl[i]:=physv
  phys\ask("Position y"&si&" (m)",0)
  yl[i]:=physv
EndFor
phys\ask("Target charge q0 (C)",0)
q0:=physv
phys\ask("Target x0 (m)",0)
x0:=physv
phys\ask("Target y0 (m)",0)
y0:=physv
If physok=0 Then
  Return
EndIf
Disp "GIVEN:"
For i,1,n
  si:=string(i)
  phys\pk({"q"&si&" = "&phys\sn(ql[i])&" C"," at ("&phys\sn(xl[i])&",",phys\sn(yl[i])&")"})
EndFor
phys\pk({"q0 = "&phys\sn(q0)&" C"," at ("&phys\sn(x0)&",",phys\sn(y0)&")"})
For i,1,n
  If xl[i]=x0 and yl[i]=y0 Then
    phys\out("q"&string(i)&" is AT the target:")
    Disp "  r = 0, force undefined."
    Return
  EndIf
EndFor
Disp "STEP 1: Formula"
Disp "  dx = x0-xi, dy = y0-yi"
Disp "  r = √(dx^2+dy^2)"
Disp "  F = k|qi*q0|/r^2"
Disp "  Fx = k*qi*q0*dx/r^3"
Disp "  Fy = k*qi*q0*dy/r^3"
Disp "STEP 2: Plug in"
sx:=0
sy:=0
For i,1,n
  si:=string(i)
  dx:=x0-xl[i]
  dy:=y0-yl[i]
  r:=√(dx^2+dy^2)
  f:=kc*abs(ql[i]*q0)/r^2
  phys\out("SOURCE q"&si&":")
  phys\out("  dx = "&phys\sn(dx)&" m")
  phys\out("  dy = "&phys\sn(dy)&" m")
  phys\out("  r = "&phys\sn(r)&" m")
  phys\pk({"F = (8.99ᴇ9)","|("&phys\sn(ql[i])&")","("&phys\sn(q0)&")|","/("&phys\sn(r)&")^2"})
  phys\out("  F = "&phys\sf(f)&" N")
  ux:=dx/r
  uy:=dy/r
  If ql[i]*q0>0 Then
    s:=1
    phys\out("  repel: away from q"&si)
  ElseIf ql[i]*q0<0 Then
    s:=−1
    phys\out("  attract: toward q"&si)
  Else
    s:=0
    Disp "  zero charge: no force"
  EndIf
  fx:=s*f*ux
  fy:=s*f*uy
  phys\out("  Fx = "&phys\sf(fx)&" N")
  phys\out("  Fy = "&phys\sf(fy)&" N")
  sx:=sx+fx
  sy:=sy+fy
EndFor
fm:=√(sx^2+sy^2)
Disp "STEP 3: Answer"
phys\out("  Fx = "&phys\sf(sx)&" N")
phys\out("  Fy = "&phys\sf(sy)&" N")
Disp "  |F| = √(Fx^2+Fy^2)"
phys\out("  |F| = "&phys\sf(fm)&" N")
Disp "DIRECTION:"
If fm=0 Then
  Disp "  none (net force is 0)"
ElseIf sx=0 Then
  If sy>0 Then
    Disp "  straight +y (90° CCW)"
  Else
    Disp "  straight −y (270° CCW)"
  EndIf
ElseIf sy=0 Then
  If sx>0 Then
    Disp "  straight +x (0°)"
  Else
    Disp "  straight −x (180°)"
  EndIf
Else
  ang:=tan⁻¹(abs(sy)/abs(sx))
  Disp "  th = tan⁻¹(|Fy|/|Fx|)"
  If sy>0 Then
    w1:="above"
  Else
    w1:="below"
  EndIf
  If sx>0 Then
    w2:="+x"
  Else
    w2:="−x"
  EndIf
  phys\out("  "&phys\sf(ang)&"° "&w1&" "&w2&" axis")
  If sx>0 and sy>0 Then
    std:=ang
  ElseIf sx<0 and sy>0 Then
    std:=180-ang
  ElseIf sx<0 and sy<0 Then
    std:=180+ang
  Else
    std:=360-ang
  EndIf
  phys\out("  = "&phys\sf(std)&"° CCW from +x")
EndIf
EndPrgm

Define LibPriv m215()=
Prgm
Local q1,x1,q2,x2,kc,a1,a2,s1,s2,same,xl,xr,nl,nr,al,ar,x,e1,e2
kc:=8.99ᴇ9
phys\hdr("21.5 Zero-force point")
phys\ask("Charge q1 (C)",0)
q1:=physv
phys\ask("Position x1 (m)",0)
x1:=physv
phys\ask("Charge q2 (C)",0)
q2:=physv
phys\ask("Position x2 (m)",0)
x2:=physv
If physok=0 Then
  Return
EndIf
Disp "GIVEN:"
phys\out("  q1 = "&phys\sn(q1)&" C")
phys\out("  x1 = "&phys\sn(x1)&" m")
phys\out("  q2 = "&phys\sn(q2)&" C")
phys\out("  x2 = "&phys\sn(x2)&" m")
If q1=0 and q2=0 Then
  Disp "Both charges are zero."
  Disp "DIRECTION: no force anywhere"
  Return
EndIf
If x1=x2 Then
  If q1+q2=0 Then
    Disp "Charges cancel at one point."
    Disp "Field is zero elsewhere."
  Else
    Disp "Same point: use q1+q2."
    Disp "  Need x1 ≠ x2 to balance."
  EndIf
  Return
EndIf
If q1=0 or q2=0 Then
  Disp "Only one charge acts."
  Disp "No finite zero-force point."
  Return
EndIf
a1:=abs(q1)
a2:=abs(q2)
If x1<x2 Then
  xl:=x1
  xr:=x2
  nl:="q1"
  nr:="q2"
  al:=a1
  ar:=a2
Else
  xl:=x2
  xr:=x1
  nl:="q2"
  nr:="q1"
  al:=a2
  ar:=a1
EndIf
same:=0
If q1*q2>0 Then
  same:=1
EndIf
Disp "REGION CHECK:"
phys\out("LEFT, x < "&phys\sn(xl)&":")
If same=1 Then
  Disp "  Same direction: no."
Else
  Disp "  Opposite directions."
  If al<ar Then
    phys\out("  Closer "&nl&" is smaller:")
    Disp "  can balance -> YES"
  Else
    phys\out("  Closer "&nl&" is not smaller:")
    Disp "  no balance."
  EndIf
EndIf
Disp "BETWEEN the charges:"
If same=1 Then
  Disp "  Opposite directions: YES."
Else
  Disp "  Same direction: no."
EndIf
phys\out("RIGHT, x > "&phys\sn(xr)&":")
If same=1 Then
  Disp "  Same direction: no."
Else
  Disp "  Opposite directions."
  If ar<al Then
    phys\out("  Closer "&nr&" is smaller:")
    Disp "  can balance -> YES"
  Else
    phys\out("  Closer "&nr&" is not smaller:")
    Disp "  no balance."
  EndIf
EndIf
If same=0 and a1=a2 Then
  Disp "NO finite zero-force point."
  Disp "Outside: nearer charge wins."
  Disp "Between: same direction."
  Return
EndIf
Disp "STEP 1: Formula"
Disp "  √|q1|*|x-x2|"
Disp "    = √|q2|*|x-x1|"
Disp "  s1=√|q1|, s2=√|q2|"
s1:=√(a1)
s2:=√(a2)
Disp "  x = x1+(x2-x1)*s1"
If same=1 Then
  Disp "      /(s1+s2)"
Else
  Disp "      *(s1+s2)/(|q1|-|q2|)"
EndIf
Disp "STEP 2: Plug in"
If same=1 Then
  phys\pk({"x = ("&phys\sn(x1)&")","+("&phys\sn(x2-x1)&")","*("&phys\sn(s1)&")","/("&phys\sn(s1+s2)&")"})
  x:=x1+(x2-x1)*s1/(s1+s2)
Else
  phys\pk({"x = ("&phys\sn(x1)&")","+("&phys\sn(x2-x1)&")","*("&phys\sn(s1)&")","*("&phys\sn(s1+s2)&")","/("&phys\sn(a1-a2)&")"})
  x:=x1+(x2-x1)*s1*(s1+s2)/(a1-a2)
EndIf
Disp "STEP 3: Answer"
phys\out("  x = "&phys\sf(x)&" m")
If x<xl Then
  Disp "  (left of both charges)"
ElseIf x>xr Then
  Disp "  (right of both charges)"
Else
  Disp "  (between the charges)"
EndIf
If x=x1 or x=x2 Then
  Disp "Too close to a source to"
  Disp "resolve with these numbers."
  Return
EndIf
e1:=kc*a1/(x-x1)^2
e2:=kc*a2/(x-x2)^2
Disp "  Check: field magnitudes"
phys\out("  q1: "&phys\sf(e1)&" N/C")
phys\out("  q2: "&phys\sf(e2)&" N/C")
Disp "DIRECTION:"
Disp "  Equal and opposite fields."
Disp "  Net force is zero."
EndPrgm

Define LibPriv m216()=
Prgm
Local c,m,lt,th,q,kc,gg,mg,tt,fe,d,ratio,tv,tscl,tlo,thi,tmid,rv,want,ct,j,okth
kc:=8.99ᴇ9
gg:=9.8
setMode({2,2,3,1,4,1,5,1})
phys\hdr("21.6 Hanging spheres")
Disp "Equal masses, equal charges."
phys\ask("1=find charge 2=find angle",102)
c:=physv
phys\ask("Mass of each sphere (kg)",1)
m:=physv
phys\ask("Length of each thread (m)",1)
lt:=physv
If c=1 Then
  phys\ask("Angle from vertical (deg)",4)
  th:=physv
Else
  phys\ask("Charge on each sphere (C)",3)
  q:=physv
EndIf
If physok=0 Then
  Return
EndIf
mg:=m*gg
Disp "GIVEN:"
phys\out("  m = "&phys\sn(m)&" kg")
phys\out("  L = "&phys\sn(lt)&" m")
Disp "  g = 9.8 m/s^2"
If c=1 Then
  phys\out("  th = "&phys\sn(th)&"°")
Else
  phys\out("  q = "&phys\sn(q)&" C")
EndIf
Disp "STEP 1: Formula"
Disp "  T cos(th) = mg"
Disp "  T sin(th) = Fe"
Disp "  T = mg/cos(th)"
Disp "  Fe = mg tan(th)"
Disp "  d = 2L sin(th)"
If c=1 Then
  Disp "  |q| = √(Fe*d^2/k)"
Else
  Disp "  sin^2(th)*tan(th)"
  Disp "    = kq^2/(4L^2*mg)"
EndIf
Disp "STEP 2: Plug in"
If c=1 Then
  tt:=mg/cos(th°)
  fe:=mg*tan(th°)
  d:=2*lt*sin(th°)
  q:=√(fe*d^2/kc)
  phys\pk({"T = ("&phys\sn(m)&")*(9.8)","/cos("&phys\sn(th)&"°)"})
  phys\pk({"Fe = ("&phys\sn(m)&")*(9.8)","*tan("&phys\sn(th)&"°)"})
  phys\pk({"d = 2*("&phys\sn(lt)&")","*sin("&phys\sn(th)&"°)"})
  phys\pk({"|q| = √(("&phys\sn(fe)&")","*("&phys\sn(d)&")^2","/8.99ᴇ9)"})
Else
  ratio:=kc*q^2/(4*lt^2*mg)
  phys\pk({"= (8.99ᴇ9)*("&phys\sn(q)&")^2","/(4*("&phys\sn(lt)&")^2","*("&phys\sn(m)&")*(9.8))"})
  phys\out("  right side = "&phys\sf(ratio))
  DelVar phzt
  Try
    th:=approx(nSolve(sin(phzt°)^2*tan(phzt°)=ratio,phzt,0,89.9999))
  Else
    th:="none"
    ClrErr
  EndTry
  DelVar phzt
  okth:=0
  If getType(th)="NUM" Then
    If th>0 and th<90 Then
      tv:=tan(th°)
      If tv≥1 Then
        rv:=tv/(1+(1/tv)^2)
      Else
        rv:=tv^3/(1+tv^2)
      EndIf
      If abs(rv/ratio-1)<1ᴇ−8 Then
        okth:=1
      EndIf
    EndIf
  EndIf
  If okth=0 Then
    ©t=tan(th); t^3/(1+t^2)=ratio, monotone for t>0.
    tscl:=max(ratio,ratio^(1/3))
    tlo:=1
    thi:=2
    If tscl≥1 Then
      want:=ratio/tscl
    Else
      want:=ratio/tscl^3
    EndIf
    For j,1,60
      tmid:=(tlo+thi)/2
      If tscl≥1 Then
        rv:=tmid/(1+(1/tscl/tmid)^2)
      Else
        rv:=tmid^3/(1+(tscl*tmid)^2)
      EndIf
      If rv>want Then
        thi:=tmid
      Else
        tlo:=tmid
      EndIf
    EndFor
    tv:=tscl*(tlo+thi)/2
    th:=approx(tan⁻¹(tv))
  EndIf
  fe:=mg*tv
  If tv≥1 Then
    ct:=√(1+(1/tv)^2)
    d:=2*lt/ct
    tt:=fe*ct
  Else
    ct:=√(1+tv^2)
    d:=2*lt*tv/ct
    tt:=mg*ct
  EndIf
EndIf
Disp "STEP 3: Answer"
If c=1 Then
  phys\out("  q = "&phys\sf(q)&" C")
Else
  If th≥89.95 Then
    Disp "  th = 90.0° (rounded)"
    Disp "  Actual angle is below 90°."
  Else
    phys\out("  th = "&phys\sf(th)&"°")
  EndIf
EndIf
phys\out("  T = "&phys\sf(tt)&" N")
phys\out("  Fe = "&phys\sf(fe)&" N")
phys\out("  d = "&phys\sf(d)&" m")
Disp "DIRECTION:"
Disp "  Same signs repel."
If c=1 Then
  Disp "  q is size; + or - unknown."
Else
  Disp "  Force pushes them apart."
EndIf
EndPrgm

Define LibPriv m221()=
Prgm
Local ef,c,a,lt,wd,rf,ang,an,ap,phi
setMode({2,2,3,1,4,1,5,1})
phys\hdr("22.1 Flux, flat area")
phys\ask("Field E in N/C",2)
ef:=physv
phys\ask("Area: 1=enter A, 2=L x W",102)
c:=physv
If c=1 Then
  phys\ask("Area A in m^2",1)
  a:=physv
Else
  phys\ask("Length L in m",1)
  lt:=physv
  phys\ask("Width W in m",1)
  wd:=physv
EndIf
phys\ask("Angle from: 1=PLANE 2=NORMAL",102)
rf:=physv
phys\ask("Angle in deg (0-90)",5)
ang:=physv
If physok=0 Then
  Return
EndIf
Disp "GIVEN:"
phys\out("  E = "&phys\sn(ef)&" N/C")
If c=2 Then
  a:=lt*wd
  phys\out("  L = "&phys\sn(lt)&" m")
  phys\out("  W = "&phys\sn(wd)&" m")
  phys\out("  A = L*W = "&phys\sn(a)&" m^2")
Else
  phys\out("  A = "&phys\sn(a)&" m^2")
EndIf
If rf=1 Then
  ap:=ang
  an:=90-ang
Else
  an:=ang
  ap:=90-ang
EndIf
phys\out("  from plane = "&phys\sn(ap)&"°")
phys\out("  from normal = "&phys\sn(an)&"°")
Disp "STEP 1: Formula"
Disp "  Phi = E*A*cos(normal)"
Disp "  normal = 90° - plane"
Disp "STEP 2: Plug in"
phys\pk({"Phi = ("&phys\sn(ef)&")","("&phys\sn(a)&")","cos("&phys\sn(an)&"°)"})
If an=90 Then
  phi:=0
Else
  phi:=ef*a*cos(an°)
EndIf
Disp "STEP 3: Answer"
phys\out("  Phi = "&phys\sf(phi)&" N*m^2/C")
Disp "DIRECTION:"
If ef=0 Then
  Disp "  No field: zero flux."
ElseIf an=90 Then
  Disp "  E lies in the plane."
  Disp "  No field lines cross."
Else
  Disp "  Positive for chosen normal"
  Disp "  Reverse normal: flip sign."
EndIf
EndPrgm

Define LibPriv m222()=
Prgm
Local c,q,phi,e0,n,i,si,ql,xl,yl,r,d,qen,edge
e0:=8.854ᴇ−12
phys\hdr("22.2 Flux from Q_enc")
Disp "1 Phi from Q  2 Q from Phi"
Disp "3 charges in a sphere"
phys\ask("1=flux 2=charge 3=sphere",103)
c:=physv
If physok=0 Then
  Return
EndIf
If c=1 Then
  phys\ask("Enclosed charge Q in C",0)
  q:=physv
  If physok=0 Then
    Return
  EndIf
  Disp "GIVEN:"
  phys\out("  Q_enc = "&phys\sn(q)&" C")
  Disp "STEP 1: Formula"
  Disp "  Phi = Q_enc/ε0"
  Disp "STEP 2: Plug in"
  phys\pk({"Phi = ("&phys\sn(q)&")","/(8.854ᴇ−12)"})
  phi:=q/e0
  Disp "STEP 3: Answer"
  phys\out("  Phi = "&phys\sf(phi)&" N*m^2/C")
ElseIf c=2 Then
  phys\ask("Flux in N*m^2/C (-=inward)",0)
  phi:=physv
  If physok=0 Then
    Return
  EndIf
  Disp "GIVEN:"
  phys\out("  Phi = "&phys\sn(phi)&" N*m^2/C")
  Disp "STEP 1: Formula"
  Disp "  Q_enc = ε0*Phi"
  Disp "STEP 2: Plug in"
  phys\pk({"Q = (8.854ᴇ−12)","("&phys\sn(phi)&")"})
  q:=e0*phi
  Disp "STEP 3: Answer"
  phys\out("  Q_enc = "&phys\sf(q)&" C")
Else
  phys\ask("Number of charges 1-4",104)
  n:=physv
  If physok=0 Then
    Return
  EndIf
  ql:=newList(n)
  xl:=newList(n)
  yl:=newList(n)
  For i,1,n
    si:=string(i)
    phys\ask("Charge q"&si&" in C",0)
    ql[i]:=physv
    phys\ask("x"&si&" in m",0)
    xl[i]:=physv
    phys\ask("y"&si&" in m",0)
    yl[i]:=physv
  EndFor
  If physok=0 Then
    Return
  EndIf
  Loop
    phys\ask("Sphere radius R in m",1)
    r:=physv
    If physok=0 Then
      Return
    EndIf
    Disp "GIVEN:"
    Disp "  Sphere centered at origin"
    For i,1,n
      si:=string(i)
      phys\pk({"q"&si&" = "&phys\sn(ql[i])&" C"," at ("&phys\sn(xl[i])&",",phys\sn(yl[i])&") m"})
    EndFor
    phys\out("  R = "&phys\sn(r)&" m")
    Disp "STEP 1: Formula"
    Disp "  d = √(x^2+y^2)"
    Disp "  Q_enc = sum with d < R"
    Disp "  Phi = Q_enc/ε0"
    Disp "STEP 2: Plug in"
    qen:=0
    edge:=0
    For i,1,n
      si:=string(i)
      d:=approx(√(xl[i]^2+yl[i]^2))
      phys\out("  q"&si&": d = "&phys\sn(d)&" m")
      If d<r Then
        Disp "    d < R: inside"
        qen:=qen+ql[i]
      ElseIf d>r Then
        Disp "    d > R: outside"
      ElseIf ql[i]=0 Then
        Disp "    On surface, q=0: no flux"
      Else
        Disp "    ON surface: undefined"
        edge:=1
      EndIf
    EndFor
    If edge=0 Then
      phys\pk({"Phi = ("&phys\sn(qen)&")","/(8.854ᴇ−12)"})
      phi:=qen/e0
      Disp "STEP 3: Answer"
      phys\out("  Q_enc = "&phys\sf(qen)&" C")
      phys\out("  Phi = "&phys\sf(phi)&" N*m^2/C")
      Disp "DIRECTION:"
      If phi>0 Then
        Disp "  Outward: positive Q_enc."
      ElseIf phi<0 Then
        Disp "  Inward: negative Q_enc."
      Else
        Disp "  Zero net flux: Q_enc = 0."
      EndIf
    Else
      Disp "STEP 3: Answer"
      Disp "  Flux is undefined here."
      Disp "DIRECTION: undefined"
      Disp "  A point charge is on R."
      Disp "  Choose a different radius."
    EndIf
    phys\ask("Another radius? 1=yes 0=no",201)
    If physok=0 or physv=0 Then
      Return
    EndIf
  EndLoop
EndIf
Disp "DIRECTION:"
If phi>0 Then
  Disp "  Outward: positive Q_enc."
ElseIf phi<0 Then
  Disp "  Inward: negative Q_enc."
Else
  Disp "  Zero net flux: Q_enc = 0."
EndIf
EndPrgm

Define LibPriv m223()=
Prgm
Local c,s2,lam,r,ef,er,l,phi,e0
e0:=8.854ᴇ−12
phys\hdr("22.3 Line charge")
Disp "1 E from λ and r"
Disp "2 λ from E data"
Disp "3 flux thru coax cylinder"
phys\ask("1=field 2=line charge 3=flux",103)
c:=physv
If physok=0 Then
  Return
EndIf
If c=1 Then
  phys\ask("Line charge λ in C/m",0)
  lam:=physv
  phys\ask("Distance r from line in m",1)
  r:=physv
  If physok=0 Then
    Return
  EndIf
  Disp "GIVEN:"
  phys\out("  λ = "&phys\sn(lam)&" C/m")
  phys\out("  r = "&phys\sn(r)&" m")
  Disp "STEP 1: Formula"
  Disp "  E = λ/(2π ε0 r)"
  Disp "STEP 2: Plug in"
  phys\pk({"E = ("&phys\sn(lam)&")","/(2π(8.854ᴇ−12)","("&phys\sn(r)&"))"})
  ef:=lam/(2*π*e0*r)
  Disp "STEP 3: Answer"
  phys\out("  E = "&phys\sf(abs(ef))&" N/C")
ElseIf c=2 Then
  phys\ask("Data: 1=E and r, 2=product E*r",102)
  s2:=physv
  If s2=1 Then
    phys\ask("Field E in N/C (-=inward)",0)
    ef:=physv
    phys\ask("Distance r in m",1)
    r:=physv
  Else
    phys\ask("E*r in N*m/C (-=inward)",0)
    er:=physv
  EndIf
  If physok=0 Then
    Return
  EndIf
  Disp "GIVEN:"
  If s2=1 Then
    phys\out("  E = "&phys\sn(ef)&" N/C")
    phys\out("  r = "&phys\sn(r)&" m")
    er:=ef*r
  Else
    phys\out("  E*r = "&phys\sn(er)&" N*m/C")
  EndIf
  Disp "STEP 1: Formula"
  Disp "  λ = 2π ε0 (E*r)"
  Disp "STEP 2: Plug in"
  phys\pk({"λ = 2π(8.854ᴇ−12)","("&phys\sn(er)&")"})
  lam:=2*π*e0*er
  Disp "STEP 3: Answer"
  phys\out("  λ = "&phys\sf(lam)&" C/m")
Else
  phys\ask("Line charge λ in C/m",0)
  lam:=physv
  phys\ask("Cylinder length l in m",1)
  l:=physv
  If physok=0 Then
    Return
  EndIf
  Disp "GIVEN:"
  phys\out("  λ = "&phys\sn(lam)&" C/m")
  phys\out("  l = "&phys\sn(l)&" m")
  Disp "STEP 1: Formula"
  Disp "  Phi = λ*l/ε0"
  Disp "  Cylinder radius cancels."
  Disp "STEP 2: Plug in"
  phys\pk({"Phi = ("&phys\sn(lam)&")","("&phys\sn(l)&")","/(8.854ᴇ−12)"})
  phi:=lam*l/e0
  Disp "STEP 3: Answer"
  phys\out("  Phi = "&phys\sf(phi)&" N*m^2/C")
EndIf
Disp "DIRECTION:"
If lam>0 Then
  Disp "  Outward: positive λ."
ElseIf lam<0 Then
  Disp "  Inward: negative λ."
Else
  Disp "  No charge: E and flux = 0."
EndIf
EndPrgm

Define LibPriv m224(f)=
Prgm
Local c,q,rr,r,n,i,si,ql,rl,qen,ev,kc,a,rho,b,rm,tq,fv
kc:=8.99ᴇ9
If f=1 Then
  phys\hdr("22.5 Force from shell")
Else
  phys\hdr("22.4 Sphere: E at r")
EndIf
Disp "1 point charge / thin shell"
Disp "2 insulating solid sphere"
Disp "3 conducting sphere"
Disp "4 concentric shells"
Disp "5 q in cavity of material"
phys\ask("Object type 1-5",105)
c:=physv
If physok=0 Then
  Return
EndIf
If c=1 Then
  phys\ask("Total charge Q in C",0)
  q:=physv
  phys\ask("Shell radius R in m (0=point)",2)
  rr:=physv
  phys\ask("Distance r from center in m",1)
  r:=physv
ElseIf c=2 or c=3 Then
  phys\ask("Total charge Q in C",0)
  q:=physv
  phys\ask("Sphere radius R in m",1)
  rr:=physv
  phys\ask("Distance r from center in m",1)
  r:=physv
ElseIf c=4 Then
  phys\ask("Number of shells 1-4",104)
  n:=physv
  If physok=0 Then
    Return
  EndIf
  ql:=newList(n)
  rl:=newList(n)
  For i,1,n
    si:=string(i)
    phys\ask("Charge Q"&si&" in C",0)
    ql[i]:=physv
    phys\ask("Radius R"&si&" in m",2)
    rl[i]:=physv
  EndFor
  phys\ask("Distance r from center in m",1)
  r:=physv
Else
  phys\ask("Charge q at center in C",0)
  q:=physv
  phys\ask("Cavity radius a in m",1)
  a:=physv
  phys\ask("Charge density rho in C/m^3",0)
  rho:=physv
  phys\ask("Outer radius b in m (0=none)",2)
  b:=physv
  phys\ask("Distance r from center in m",1)
  r:=physv
EndIf
If f=1 Then
  phys\ask("Test charge q in C",0)
  tq:=physv
EndIf
If physok=0 Then
  Return
EndIf
Disp "GIVEN:"
If c=4 Then
  For i,1,n
    si:=string(i)
    phys\out("  Q"&si&" = "&phys\sn(ql[i])&" C")
    phys\out("  R"&si&" = "&phys\sn(rl[i])&" m")
  EndFor
ElseIf c=5 Then
  phys\out("  q = "&phys\sn(q)&" C")
  phys\out("  a = "&phys\sn(a)&" m")
  phys\out("  rho = "&phys\sn(rho)&" C/m^3")
  If b>0 Then
    phys\out("  b = "&phys\sn(b)&" m")
  Else
    Disp "  No outer edge of material"
  EndIf
  If b>0 and b≤a Then
    Disp "Outer radius b must be"
    Disp "  bigger than cavity a."
    Return
  EndIf
Else
  phys\out("  Q = "&phys\sn(q)&" C")
  phys\out("  R = "&phys\sn(rr)&" m")
EndIf
phys\out("  r = "&phys\sn(r)&" m")
If f=1 Then
  phys\out("  Test q = "&phys\sn(tq)&" C")
EndIf
Disp "STEP 1: Formula"
Disp "  E = k*Q_enc/r^2"
If c=2 Then
  Disp "  Inside: Q_enc = Q*r^3/R^3"
ElseIf c=4 Then
  Disp "  Q_enc = sum with R ≤ r"
ElseIf c=5 Then
  If r<a Then
    Disp "  In cavity: Q_enc = q"
  Else
    Disp "  Q_enc = q + rho*V"
    Disp "  V = (4/3)π(rm^3-a^3)"
    Disp "  rm = r, capped at edge b"
  EndIf
EndIf
If f=1 Then
  Disp "  F = q*E = k*q*Q_enc/r^2"
  Disp "  Use distance r, not size R"
EndIf
Disp "STEP 2: Plug in"
If c=1 Then
  If r<rr Then
    Disp "  Inside shell: Q_enc = 0"
    qen:=0
  Else
    If r=rr Then
      Disp "  At shell: just outside"
    EndIf
    qen:=q
  EndIf
ElseIf c=2 Then
  If r<rr Then
    phys\pk({"Q_enc = ("&phys\sn(q)&")","("&phys\sn(r)&")^3","/("&phys\sn(rr)&")^3"})
    qen:=q*(r/rr)^3
  Else
    Disp "  r ≥ R: all charge inside"
    qen:=q
  EndIf
ElseIf c=3 Then
  If r<rr Then
    Disp "  In metal: Q_enc = E = 0"
    Disp "  Charge is on the surface."
    qen:=0
  Else
    If r=rr Then
      Disp "  At surface: just outside"
    EndIf
    qen:=q
  EndIf
ElseIf c=4 Then
  qen:=0
  For i,1,n
    si:=string(i)
    If rl[i]≤r Then
      phys\out("  Shell "&si&": enclosed")
      If rl[i]=r Then
        Disp "    At shell: just outside"
      EndIf
      qen:=qen+ql[i]
    Else
      phys\out("  Shell "&si&": not enclosed")
    EndIf
  EndFor
Else
  rm:=r
  If b>0 and r>b Then
    rm:=b
  EndIf
  If r<a Then
    Disp "  In cavity: only q inside"
    qen:=q
  Else
    If rm<r Then
      Disp "  Outside material: rm = b"
    EndIf
    phys\pk({"Q_enc = ("&phys\sn(q)&")","+("&phys\sn(rho)&")","(4/3)π","(("&phys\sn(rm)&")^3","-("&phys\sn(a)&")^3)"})
    qen:=q+rho*(4/3)*π*(rm-a)*(rm^2+rm*a+a^2)
  EndIf
EndIf
phys\pk({"E = (8.99ᴇ9)","("&phys\sn(qen)&")","/("&phys\sn(r)&")^2"})
ev:=kc*qen/r^2
If f=1 Then
  fv:=tq*ev
  phys\pk({"F = ("&phys\sn(tq)&")","("&phys\sn(ev)&")"})
EndIf
Disp "STEP 3: Answer"
phys\out("  Q_enc = "&phys\sf(qen)&" C")
If ev>0 Then
  phys\out("  E = "&phys\sf(ev)&" N/C outward")
ElseIf ev<0 Then
  phys\out("  E = "&phys\sf(abs(ev))&" N/C inward")
Else
  Disp "  E = 0 N/C"
EndIf
phys\out("  Signed E = "&phys\sf(ev)&" N/C")
If f=1 Then
  phys\out("  |F| = "&phys\sf(abs(fv))&" N")
  phys\out("  Signed F = "&phys\sf(fv)&" N")
EndIf
Disp "DIRECTION:"
If ev>0 Then
  Disp "  E outward: Q_enc > 0."
ElseIf ev<0 Then
  Disp "  E inward: Q_enc < 0."
Else
  Disp "  E = 0: no net field."
EndIf
If f=1 Then
  If fv>0 Then
    Disp "  F away from center: qE>0."
  ElseIf fv<0 Then
    Disp "  F toward center: qE<0."
  Else
    Disp "  F = 0: no force."
  EndIf
EndIf
EndPrgm

Define LibPriv m225()=
Prgm
phys\m224(1)
EndPrgm

Define LibPriv m226()=
Prgm
Local c,q,rr,er2,phi,e0,sig,rho,ev
e0:=8.854ᴇ−12
phys\hdr("22.6 Charge densities")
Disp "1 σ = Q/(4πR^2) surface"
Disp "2 ρ = Q/((4/3)πR^3)"
Disp "3 ρ from E*r^2 data"
Disp "4 sphere from its flux"
phys\ask("Type 1-4",104)
c:=physv
If c=1 or c=2 Then
  phys\ask("Charge Q in C",0)
  q:=physv
ElseIf c=3 Then
  phys\ask("E*r^2 in N*m^2/C (-=inward)",0)
  er2:=physv
Else
  phys\ask("Flux in N*m^2/C (-=inward)",0)
  phi:=physv
EndIf
phys\ask("Sphere radius R in m",1)
rr:=physv
If physok=0 Then
  Return
EndIf
Disp "GIVEN:"
phys\out("  R = "&phys\sn(rr)&" m")
If c=1 or c=2 Then
  phys\out("  Q = "&phys\sn(q)&" C")
ElseIf c=3 Then
  phys\out("  E*r^2 = "&phys\sn(er2)&" N*m^2/C")
Else
  phys\out("  Phi = "&phys\sn(phi)&" N*m^2/C")
EndIf
Disp "STEP 1: Formula"
If c=1 Then
  Disp "  σ = Q/(4πR^2)"
ElseIf c=2 Then
  Disp "  ρ = Q/((4/3)πR^3)"
ElseIf c=3 Then
  Disp "  Q = 4π ε0 (E*r^2)"
  Disp "  ρ = 3 ε0 (E*r^2)/R^3"
  Disp "  Field data: outside sphere"
Else
  Disp "  Q = ε0*Phi"
  Disp "  E = |Phi|/(4πR^2)"
  Disp "  σ = Q/(4πR^2)"
  Disp "  Charge must be symmetric."
EndIf
Disp "STEP 2: Plug in"
If c=1 Then
  phys\pk({"σ = ("&phys\sn(q)&")","/(4π("&phys\sn(rr)&")^2)"})
  sig:=q/(4*π*rr^2)
ElseIf c=2 Then
  phys\pk({"ρ = ("&phys\sn(q)&")","/((4/3)π","("&phys\sn(rr)&")^3)"})
  rho:=q/((4/3)*π*rr^3)
ElseIf c=3 Then
  phys\pk({"Q = 4π(8.854ᴇ−12)","("&phys\sn(er2)&")"})
  q:=4*π*e0*er2
  phys\pk({"ρ = 3(8.854ᴇ−12)","("&phys\sn(er2)&")","/("&phys\sn(rr)&")^3"})
  rho:=3*e0*er2/rr^3
Else
  phys\pk({"Q = (8.854ᴇ−12)","("&phys\sn(phi)&")"})
  q:=e0*phi
  phys\pk({"E = "&phys\sn(abs(phi)),"/(4π("&phys\sn(rr)&")^2)"})
  ev:=abs(phi)/(4*π*rr^2)
  phys\pk({"σ = ("&phys\sn(q)&")","/(4π("&phys\sn(rr)&")^2)"})
  sig:=q/(4*π*rr^2)
EndIf
Disp "STEP 3: Answer"
If c=1 Then
  phys\out("  σ = "&phys\sf(sig)&" C/m^2")
ElseIf c=2 Then
  phys\out("  ρ = "&phys\sf(rho)&" C/m^3")
ElseIf c=3 Then
  phys\out("  Q = "&phys\sf(q)&" C")
  phys\out("  ρ = "&phys\sf(rho)&" C/m^3")
Else
  phys\out("  Q = "&phys\sf(q)&" C")
  If phi<0 Then
    phys\out("  E = "&phys\sf(ev)&" N/C inward")
  ElseIf phi>0 Then
    phys\out("  E = "&phys\sf(ev)&" N/C outward")
  Else
    Disp "  E = 0 N/C"
  EndIf
  phys\out("  σ = "&phys\sf(sig)&" C/m^2")
EndIf
Disp "DIRECTION:"
If q>0 Then
  Disp "  Positive density: Q > 0."
  If c=4 Then
    Disp "  Field points outward."
  EndIf
ElseIf q<0 Then
  Disp "  Negative density: Q < 0."
  If c=4 Then
    Disp "  Field points inward."
  EndIf
Else
  Disp "  No charge: density = 0."
  If c=4 Then
    Disp "  No field direction."
  EndIf
EndIf
EndPrgm

Define LibPriv m227()=
Prgm
Local lam,lo,a,b,c,r,e0,ev,le
e0:=8.854ᴇ−12
phys\hdr("22.7 Coaxial cable")
phys\ask("Inner line charge λ in C/m",0)
lam:=physv
phys\ask("Outer net λ in C/m (0=neutral)",0)
lo:=physv
phys\ask("Inner radius a in m (0=line)",2)
a:=physv
phys\ask("Tube inner radius b in m",1)
b:=physv
phys\ask("Tube outer radius c in m",1)
c:=physv
phys\ask("Distance r from axis in m",1)
r:=physv
If physok=0 Then
  Return
EndIf
Disp "GIVEN:"
phys\out("  λ inner = "&phys\sn(lam)&" C/m")
phys\out("  λ outer = "&phys\sn(lo)&" C/m")
phys\out("  a = "&phys\sn(a)&" m")
phys\out("  b = "&phys\sn(b)&" m")
phys\out("  c = "&phys\sn(c)&" m")
phys\out("  r = "&phys\sn(r)&" m")
If not (a<b and b<c) Then
  Disp "Need a < b < c (inner wire"
  Disp "  inside the outer tube)."
  Return
EndIf
Disp "STEP 1: Formula"
Disp "  E = λ_enc/(2π ε0 r)"
Disp "  In metal: E = 0."
Disp "  Tube inner surface: -λ"
Disp "  Tube outer surface: λ+λo"
Disp "STEP 2: Plug in"
If r=a or r=b or r=c Then
  Disp "  At surface: outward side"
EndIf
If r<a Then
  Disp "  r < a: inside inner metal"
  le:=0
ElseIf r<b Then
  Disp "  a ≤ r < b: between them"
  le:=lam
ElseIf r<c Then
  Disp "  b ≤ r < c: in outer metal"
  le:=0
Else
  Disp "  r ≥ c: outside the cable"
  le:=lam+lo
EndIf
phys\pk({"E = ("&phys\sn(le)&")","/(2π(8.854ᴇ−12)","("&phys\sn(r)&"))"})
ev:=le/(2*π*e0*r)
Disp "STEP 3: Answer"
phys\out("  E = "&phys\sf(abs(ev))&" N/C")
phys\out("  inner surface: "&phys\sf(−lam)&" C/m")
phys\out("  outer surface: "&phys\sf(lam+lo)&" C/m")
Disp "  E=0 in metal needs Q_enc=0"
Disp "DIRECTION:"
If ev>0 Then
  Disp "  Outward: λ_enc > 0."
ElseIf ev<0 Then
  Disp "  Inward: λ_enc < 0."
Else
  Disp "  E = 0: no net field."
EndIf
EndPrgm

Define LibPriv m231()=
Prgm
Local c,n,i,j,si,sj,ql,xl,yl,np,qa,qb,rl,kc,r,u,ut
kc:=8.99ᴇ9
phys\hdr("23.1 U of charges")
Disp "1 charges at (x,y)"
Disp "2 enter pairs (qa,qb,r)"
phys\ask("1=positions 2=pairs directly",102)
c:=physv
If physok=0 Then
  Return
EndIf
ut:=0
If c=1 Then
  n:=0
  While n<2 and physok=1
    phys\ask("Number of charges 2-4",104)
    n:=physv
    If n<2 and physok=1 Then
      Text "U needs at least 2 charges"
    EndIf
  EndWhile
  If physok=0 Then
    Return
  EndIf
  ql:=newList(n)
  xl:=newList(n)
  yl:=newList(n)
  For i,1,n
    si:=string(i)
    phys\ask("Charge q"&si&" (C)",0)
    ql[i]:=physv
    phys\ask("x"&si&" in m",0)
    xl[i]:=physv
    phys\ask("y"&si&" in m",0)
    yl[i]:=physv
  EndFor
  If physok=0 Then
    Return
  EndIf
  Disp "GIVEN:"
  For i,1,n
    si:=string(i)
    phys\pk({"q"&si&" = "&phys\sn(ql[i])&" C"," at ("&phys\sn(xl[i])&",",phys\sn(yl[i])&")"})
  EndFor
  Disp "STEP 1: Formula"
  Disp "  U = sum k*qi*qj/rij"
  Disp "  (each pair counted once)"
  Disp "STEP 2: Plug in"
  For i,1,n-1
    For j,i+1,n
      si:=string(i)
      sj:=string(j)
      r:=√((xl[i]-xl[j])^2+(yl[i]-yl[j])^2)
      u:=0
      If ql[i]≠0 and ql[j]≠0 Then
        If r=0 Then
          phys\out("q"&si&" and q"&sj&" coincide:")
          Disp "  r = 0, U is infinite."
          Return
        EndIf
        u:=kc*ql[i]*ql[j]/r
      EndIf
      phys\out("PAIR "&si&"-"&sj&": r = "&phys\sn(r)&" m")
      phys\pk({"U = (8.99ᴇ9)","("&phys\sn(ql[i])&")","("&phys\sn(ql[j])&")","/("&phys\sn(r)&")"})
      phys\out("  U"&si&sj&" = "&phys\sf(u)&" J")
      ut:=ut+u
    EndFor
  EndFor
Else
  phys\ask("Number of pairs 1-6",106)
  np:=physv
  If physok=0 Then
    Return
  EndIf
  qa:=newList(np)
  qb:=newList(np)
  rl:=newList(np)
  For j,1,np
    sj:=string(j)
    phys\ask("Pair "&sj&": 1st charge in C",0)
    qa[j]:=physv
    phys\ask("Pair "&sj&": 2nd charge in C",0)
    qb[j]:=physv
    phys\ask("Pair "&sj&": distance r in m",1)
    rl[j]:=physv
  EndFor
  If physok=0 Then
    Return
  EndIf
  Disp "GIVEN:"
  For j,1,np
    phys\out("  Pair "&string(j)&":")
    phys\out("  qa = "&phys\sn(qa[j])&" C")
    phys\out("  qb = "&phys\sn(qb[j])&" C")
    phys\out("  r = "&phys\sn(rl[j])&" m")
  EndFor
  Disp "STEP 1: Formula"
  Disp "  U = sum k*qa*qb/r"
  Disp "  (each pair counted once)"
  Disp "STEP 2: Plug in"
  For j,1,np
    sj:=string(j)
    u:=kc*qa[j]*qb[j]/rl[j]
    phys\out("PAIR "&sj&": r = "&phys\sn(rl[j])&" m")
    phys\pk({"U = (8.99ᴇ9)","("&phys\sn(qa[j])&")","("&phys\sn(qb[j])&")","/("&phys\sn(rl[j])&")"})
    phys\out("  U"&sj&" = "&phys\sf(u)&" J")
    ut:=ut+u
  EndFor
EndIf
Disp "STEP 3: Answer"
phys\out("  U = "&phys\sf(ut)&" J")
Disp "DIRECTION:"
If ut<0 Then
  Disp "  U < 0: separating all"
  Disp "  charges needs work."
ElseIf ut>0 Then
  Disp "  U > 0: assembly from far"
  Disp "  apart needs net work."
Else
  Disp "  Pair energies cancel."
EndIf
EndPrgm

Define LibPriv m232()=
Prgm
Local c,n,i,j,si,ql,xl,yl,pxl,pyl,pnm,np,v,sa,r,t,q,w,kc,lb,vl,ax,ay,bx,by,va,vb
kc:=8.99ᴇ9
phys\hdr("23.2 V from charges")
Disp "1 V at one point P"
Disp "2 Va, Vb and work a->b"
phys\ask("1=V at P  2=Va, Vb and work",102)
c:=physv
phys\ask("Number of charges 1-4",104)
n:=physv
If physok=0 Then
  Return
EndIf
ql:=newList(n)
xl:=newList(n)
yl:=newList(n)
For i,1,n
  si:=string(i)
  phys\ask("Charge q"&si&" (C)",0)
  ql[i]:=physv
  phys\ask("x"&si&" in m",0)
  xl[i]:=physv
  phys\ask("y"&si&" in m",0)
  yl[i]:=physv
EndFor
If c=1 Then
  phys\ask("Point P: x in m",0)
  ax:=physv
  phys\ask("Point P: y in m",0)
  ay:=physv
  pxl:={ax}
  pyl:={ay}
  pnm:={"P"}
  np:=1
Else
  phys\ask("Point a: x in m",0)
  ax:=physv
  phys\ask("Point a: y in m",0)
  ay:=physv
  phys\ask("Point b: x in m",0)
  bx:=physv
  phys\ask("Point b: y in m",0)
  by:=physv
  phys\ask("Moved charge q in C",0)
  q:=physv
  pxl:={ax,bx}
  pyl:={ay,by}
  pnm:={"a","b"}
  np:=2
EndIf
If physok=0 Then
  Return
EndIf
Disp "GIVEN:"
For i,1,n
  si:=string(i)
  phys\pk({"q"&si&" = "&phys\sn(ql[i])&" C"," at ("&phys\sn(xl[i])&",",phys\sn(yl[i])&")"})
EndFor
For j,1,np
  phys\pk({"point "&pnm[j]&" = ("&phys\sn(pxl[j])&",",phys\sn(pyl[j])&")"})
EndFor
If c=2 Then
  phys\out("  moved q = "&phys\sn(q)&" C")
EndIf
Disp "STEP 1: Formula"
Disp "  V = sum k*qi/ri"
If c=2 Then
  Disp "  W = q*(Va-Vb)"
EndIf
Disp "STEP 2: Plug in"
vl:=newList(np)
For j,1,np
  lb:=pnm[j]
  phys\out("POINT "&lb&":")
  v:=0
  sa:=0
  For i,1,n
    si:=string(i)
    r:=√((pxl[j]-xl[i])^2+(pyl[j]-yl[i])^2)
    t:=0
    If ql[i]≠0 Then
      If r=0 Then
        phys\out("Point "&lb&" is ON q"&si&":")
        Disp "  r = 0, V is infinite."
        Return
      EndIf
      t:=kc*ql[i]/r
    EndIf
    phys\out("  r"&si&" = "&phys\sn(r)&" m")
    phys\out("  kq"&si&"/r"&si&" = "&phys\sf(t)&" V")
    v:=v+t
    sa:=sa+abs(t)
  EndFor
  If abs(v)<1ᴇ−9*sa Then
    v:=0
  EndIf
  vl[j]:=v
EndFor
If c=2 Then
  va:=vl[1]
  vb:=vl[2]
  Disp "  Work from a to b:"
  phys\pk({"W = ("&phys\sn(q)&")","("&phys\sf(va)&"-(",phys\sf(vb)&"))"})
  w:=q*(va-vb)
EndIf
Disp "STEP 3: Answer"
For j,1,np
  phys\out("  V"&pnm[j]&" = "&phys\sf(vl[j])&" V")
EndFor
If c=2 Then
  phys\out("  W = "&phys\sf(w)&" J")
  Disp "  Slow outside work:"
  phys\out("  -W = "&phys\sf(−w)&" J")
EndIf
Disp "DIRECTION:"
If c=2 Then
  If w>0 Then
    Disp "  Field helps the move."
  ElseIf w<0 Then
    Disp "  Field opposes the move."
  Else
    Disp "  No work: q=0 or Va=Vb."
  EndIf
Else
  Disp "  V is a signed scalar."
  Disp "  Add terms with signs."
EndIf
EndPrgm

Define LibPriv m233()=
Prgm
Local q,ka,kb,d,kv,va,vb,w,dv,ef
phys\hdr("23.3 Work-energy")
phys\ask("Charge q (C)",3)
q:=physv
phys\ask("Kinetic energy at A (J)",2)
ka:=physv
phys\ask("Kinetic energy at B (J)",2)
kb:=physv
phys\ask("Distance A to B (m, 0=unknown)",2)
d:=physv
phys\ask("Know V at A? 1=yes 0=no",201)
kv:=physv
If kv=1 Then
  phys\ask("Potential at A (V)",0)
  va:=physv
EndIf
If physok=0 Then
  Return
EndIf
w:=kb-ka
dv:=w/q
Disp "GIVEN:"
phys\out("  q = "&phys\sn(q)&" C")
phys\out("  KA = "&phys\sn(ka)&" J")
phys\out("  KB = "&phys\sn(kb)&" J")
If d>0 Then
  phys\out("  d = "&phys\sn(d)&" m")
EndIf
If kv=1 Then
  phys\out("  VA = "&phys\sn(va)&" V")
EndIf
Disp "STEP 1: Formula"
Disp "  W = KB-KA = q*(Va-Vb)"
Disp "  Va-Vb = W/q"
If kv=1 Then
  Disp "  VB = VA-(Va-Vb)"
EndIf
If d>0 Then
  Disp "  E = |Va-Vb|/d"
EndIf
Disp "STEP 2: Plug in"
phys\pk({"W = ("&phys\sn(kb)&")","-("&phys\sn(ka)&")"})
phys\pk({"Va-Vb = ("&phys\sn(w)&")","/("&phys\sn(q)&")"})
If kv=1 Then
  vb:=va-dv
  phys\pk({"VB = ("&phys\sn(va)&")","-("&phys\sn(dv)&")"})
EndIf
If d>0 Then
  ef:=abs(dv)/d
  phys\pk({"E = "&phys\sn(abs(dv)),"/("&phys\sn(d)&")"})
EndIf
Disp "STEP 3: Answer"
phys\out("  W = "&phys\sf(w)&" J")
phys\out("  Va - Vb = "&phys\sf(dv)&" V")
If kv=1 Then
  phys\out("  VB = "&phys\sf(vb)&" V")
EndIf
If d>0 Then
  phys\out("  E = "&phys\sf(ef)&" V/m")
EndIf
Disp "DIRECTION:"
If dv>0 Then
  Disp "  E: A toward B (V falls)"
ElseIf dv<0 Then
  Disp "  E: B toward A (V falls)"
Else
  Disp "  No field component on AB."
EndIf
Disp "  Speed up: + low, - high V"
EndPrgm

Define LibPriv m234()=
Prgm
Local c,m,q,v1,v2,k1,k2,dk,dv,me,mp,qe,nm
me:=9.109ᴇ−31
mp:=1.673ᴇ−27
qe:=1.602ᴇ−19
phys\hdr("23.4 Accelerate/stop")
Disp "1 electron  2 proton"
Disp "3 custom m and q"
phys\ask("Particle: 1=e- 2=p+ 3=custom",103)
c:=physv
If c=1 Then
  m:=me
  q:=−qe
  nm:="electron"
ElseIf c=2 Then
  m:=mp
  q:=qe
  nm:="proton"
Else
  phys\ask("Mass (kg)",1)
  m:=physv
  phys\ask("Charge q (C)",3)
  q:=physv
  nm:="particle"
EndIf
phys\ask("Initial speed v1 (m/s)",2)
v1:=physv
phys\ask("Final speed v2 (m/s)",2)
v2:=physv
If physok=0 Then
  Return
EndIf
Disp "GIVEN:"
phys\out("  "&nm)
phys\out("  m = "&phys\sn(m)&" kg")
phys\out("  q = "&phys\sn(q)&" C")
phys\out("  v1 = "&phys\sn(v1)&" m/s")
phys\out("  v2 = "&phys\sn(v2)&" m/s")
If v1≥2.998ᴇ8 or v2≥2.998ᴇ8 Then
  Disp "Speed must be below light."
  Disp "  This uses K = m*v^2/2."
  Return
EndIf
k1:=0.5*m*v1^2
k2:=0.5*m*v2^2
dk:=0.5*m*(v2-v1)*(v2+v1)
dv:=dk/q
Disp "STEP 1: Formula"
Disp "  K = m*v^2/2"
Disp "  W = K2-K1 = q*(V1-V2)"
Disp "  V1-V2 = (K2-K1)/q"
Disp "STEP 2: Plug in"
phys\pk({"K1 = 0.5*("&phys\sn(m)&")","*("&phys\sn(v1)&")^2"})
phys\pk({"K2 = 0.5*("&phys\sn(m)&")","*("&phys\sn(v2)&")^2"})
phys\pk({"V1-V2 = ("&phys\sn(dk)&")","/("&phys\sn(q)&")"})
Disp "STEP 3: Answer"
phys\out("  K1 = "&phys\sf(k1)&" J")
phys\out("  K2 = "&phys\sf(k2)&" J")
phys\out("  ΔK = "&phys\sf(dk)&" J")
phys\out("  V1 - V2 = "&phys\sf(dv)&" V")
phys\out("  |ΔV| = "&phys\sf(abs(dv))&" V")
Disp "DIRECTION:"
If dv>0 Then
  phys\out("  End "&phys\sf(dv)&" V LOWER")
ElseIf dv<0 Then
  phys\out("  End "&phys\sf(abs(dv))&" V HIGHER")
Else
  Disp "  Same V: no energy change."
EndIf
EndPrgm

Define LibPriv m235()=
Prgm
Local v,ef,r,q,kc
kc:=8.99ᴇ9
phys\hdr("23.5 Point q from V,E")
phys\ask("Potential V (V)",3)
v:=physv
phys\ask("Field magnitude E (V/m)",1)
ef:=physv
If physok=0 Then
  Return
EndIf
r:=abs(v)/ef
q:=r*v/kc
Disp "GIVEN:"
phys\out("  V = "&phys\sn(v)&" V")
phys\out("  E = "&phys\sn(ef)&" V/m")
Disp "STEP 1: Formula"
Disp "  V = k*q/r; E = k*|q|/r^2"
Disp "  r = |V|/E; q = r*V/k"
Disp "STEP 2: Plug in"
phys\pk({"r = "&phys\sn(abs(v)),"/"&phys\sn(ef)})
phys\pk({"q = ("&phys\sn(r)&")","*("&phys\sn(v)&")","/8.99ᴇ9"})
Disp "STEP 3: Answer"
phys\out("  r = "&phys\sf(r)&" m")
phys\out("  q = "&phys\sf(q)&" C")
Disp "DIRECTION:"
If q>0 Then
  Disp "  q>0: E points AWAY"
Else
  Disp "  q<0: E points TOWARD"
EndIf
EndPrgm

Define LibPriv m236()=
Prgm
Local c,lam,ra,rb,q,r1,r2,e0,dv,kk,f
e0:=8.854ᴇ−12
phys\hdr("23.6 Line charge V")
Disp "1 Va - Vb near a line"
Disp "2 K gained moving r1->r2"
phys\ask("1=Va-Vb  2=K gained by q",102)
c:=physv
If c=1 Then
  phys\ask("Line charge lambda (C/m)",0)
  lam:=physv
  phys\ask("Radius at a (m)",1)
  ra:=physv
  phys\ask("Radius at b (m)",1)
  rb:=physv
Else
  phys\ask("Moving charge q (C)",0)
  q:=physv
  phys\ask("Line charge lambda (C/m)",0)
  lam:=physv
  phys\ask("Start radius r1 (m)",1)
  r1:=physv
  phys\ask("End radius r2 (m)",1)
  r2:=physv
EndIf
If physok=0 Then
  Return
EndIf
f:=approx(lam/(2*π*e0))
Disp "GIVEN:"
phys\out("  λ = "&phys\sn(lam)&" C/m")
If c=1 Then
  phys\out("  ra = "&phys\sn(ra)&" m")
  phys\out("  rb = "&phys\sn(rb)&" m")
Else
  phys\out("  q = "&phys\sn(q)&" C")
  phys\out("  r1 = "&phys\sn(r1)&" m")
  phys\out("  r2 = "&phys\sn(r2)&" m")
EndIf
Disp "STEP 1: Formula"
If c=1 Then
  Disp "  Va-Vb = λ/(2πε0)*ln(rb/ra)"
Else
  Disp "  K gained = q*(V1-V2)"
  Disp "  = q*λ/(2πε0)*ln(r2/r1)"
EndIf
Disp "STEP 2: Plug in"
If c=1 Then
  phys\pk({"Va-Vb = ("&phys\sn(f)&")","*ln("&phys\sn(rb)&"/"&phys\sn(ra)&")"})
  dv:=approx(f*ln(rb/ra))
Else
  phys\pk({"K = ("&phys\sn(q)&")","*("&phys\sn(f)&")","*ln("&phys\sn(r2)&"/"&phys\sn(r1)&")"})
  kk:=approx(q*f*ln(r2/r1))
EndIf
Disp "STEP 3: Answer"
If c=1 Then
  phys\out("  Va - Vb = "&phys\sf(dv)&" V")
Else
  phys\out("  K = "&phys\sf(kk)&" J")
EndIf
Disp "DIRECTION:"
If c=1 Then
  If dv>0 Then
    Disp "  a is at higher V."
  ElseIf dv<0 Then
    Disp "  b is at higher V."
  Else
    Disp "  a and b have equal V."
  EndIf
Else
  If kk<0 Then
    Disp "  Slows down; cannot arrive"
    Disp "  if starting from rest."
  ElseIf kk>0 Then
    Disp "  Field adds kinetic energy."
  Else
    Disp "  No kinetic energy change."
  EndIf
EndIf
EndPrgm

Define LibPriv m237()=
Prgm
Local s,t,i,n,c,pc,nc,lt,ok,vv,ex,ey,ez,eqs,vars,sol,ss,nzx,nzy,nzz
phys\hdr("23.7 E from V(x,y,z)")
Disp "Type V with * between"
Disp "letters: A*x*y-B*x^2+C*y"
s:="@@"
RequestStr "V(x,y,z)= use * e.g. A*x*y",s,0
If s="@@" or s="" Then
  physok:=0
  Return
EndIf
s:=phys\expo(s)
DelVar phza,phzb,phzc,phzd,phze,phzf,phzg,phzh,phzi,phzj,phzk,phzl,phzm,phzn,phzo,phzp,phzq,phzr,phzs,phzt,phzu,phzv,phzw,phzx,phzy,phzz
lt:="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
t:=""
n:=dim(s)
For i,1,n
  c:=mid(s,i,1)
  If inString(lt,c)>0 Then
    If i>1 Then
      pc:=mid(s,i-1,1)
    Else
      pc:=" "
    EndIf
    If i<n Then
      nc:=mid(s,i+1,1)
    Else
      nc:=" "
    EndIf
    If inString(lt&"0123456789_",pc)=0 and inString(lt&"0123456789_(",nc)=0 Then
      c:="phz"&phys\lc(c)
    EndIf
  EndIf
  t:=t&c
EndFor
t:=phys\neg(t)
ok:=1
Try
  vv:=expr(t)
  If getType(vv)="NUM" or getType(vv)="EXPR" Then
    ex:=−∂(vv,phzx)
    ey:=−∂(vv,phzy)
    ez:=−∂(vv,phzz)
  Else
    ok:=0
  EndIf
Else
  ok:=0
  ClrErr
EndTry
If ok=0 Then
  Disp "Use one expression for V."
  Disp "  Example: A*x*y-B*x^2"
  DelVar phza,phzb,phzc,phzd,phze,phzf,phzg,phzh,phzi,phzj,phzk,phzl,phzm,phzn,phzo,phzp,phzq,phzr,phzs,phzt,phzu,phzv,phzw,phzx,phzy,phzz
  Return
EndIf
Disp "GIVEN:"
phys\out("  V = "&phys\unz(string(vv)))
If inString(t,"sin(")>0 or inString(t,"cos(")>0 or inString(t,"tan(")>0 Then
  Disp "  Trig input uses degrees."
EndIf
Disp "STEP 1: Formula"
Disp "  Ex = -dV/dx"
Disp "  Ey = -dV/dy"
Disp "  Ez = -dV/dz"
Disp "STEP 2: Plug in"
Disp "  Differentiate V above."
Disp "STEP 3: Answer"
phys\out("  Ex = "&phys\unz(string(ex)))
phys\out("  Ey = "&phys\unz(string(ey)))
phys\out("  Ez = "&phys\unz(string(ez)))
Disp "  E in V/m if V in volts"
Disp "  and x,y,z in meters."
Disp "WHERE E = 0:"
eqs:=""
vars:=""
nzx:=1
nzy:=1
nzz:=1
If getType(ex)="NUM" Then
  If ex=0 Then
    nzx:=0
  EndIf
EndIf
If getType(ey)="NUM" Then
  If ey=0 Then
    nzy:=0
  EndIf
EndIf
If getType(ez)="NUM" Then
  If ez=0 Then
    nzz:=0
  EndIf
EndIf
If nzx=1 Then
  eqs:=string(ex)&"=0"
  vars:="phzx"
EndIf
If nzy=1 Then
  If eqs≠"" Then
    eqs:=eqs&","
    vars:=vars&","
  EndIf
  eqs:=eqs&string(ey)&"=0"
  vars:=vars&"phzy"
EndIf
If nzz=1 Then
  If eqs≠"" Then
    eqs:=eqs&","
    vars:=vars&","
  EndIf
  eqs:=eqs&string(ez)&"=0"
  vars:=vars&"phzz"
EndIf
If eqs="" Then
  Disp "  E = 0 everywhere"
  Disp "  (V is constant)"
Else
  Disp "  Solve nonzero parts = 0"
  ok:=1
  Try
    sol:=expr("solve({"&eqs&"},{"&vars&"})")
  Else
    ok:=0
    ClrErr
  EndTry
  If ok=0 Then
    Disp "  CAS could not solve it."
  Else
    ss:=string(sol)
    If ss="false" Then
      Disp "  E is never zero"
    Else
      Disp "  E = 0 where:"
      phys\out("  "&phys\unz(ss))
      If inString(eqs,"phzx")=0 Then
        Disp "  any x"
      EndIf
      If inString(eqs,"phzy")=0 Then
        Disp "  any y"
      EndIf
      If inString(eqs,"phzz")=0 Then
        Disp "  any z"
      EndIf
    EndIf
  EndIf
EndIf
Disp "DIRECTION:"
Disp "  E points toward lower V."
DelVar phza,phzb,phzc,phzd,phze,phzf,phzg,phzh,phzi,phzj,phzk,phzl,phzm,phzn,phzo,phzp,phzq,phzr,phzs,phzt,phzu,phzv,phzw,phzx,phzy,phzz
EndPrgm

Define LibPriv m238()=
Prgm
Local c,s2,ra,rb,vab,q,a,b,ef,r,kc,e0,lam,g,er
kc:=8.99ᴇ9
e0:=8.854ᴇ−12
phys\hdr("23.8 Vab spheres/coax")
Disp "1 concentric spheres"
Disp "2 coaxial cylinders"
phys\ask("1=spheres 2=cylinders",102)
c:=physv
If c=1 Then
  phys\ask("Find: 1=q from Vab 2=Vab from q",102)
  s2:=physv
  phys\ask("Inner radius ra (m)",1)
  ra:=physv
  phys\ask("Outer radius rb (m)",1)
  rb:=physv
  If s2=1 Then
    phys\ask("Va-Vb (V)",0)
    vab:=physv
  Else
    phys\ask("Inner sphere charge q (C)",0)
    q:=physv
  EndIf
Else
  phys\ask("Inner wire radius a (m)",1)
  a:=physv
  phys\ask("Outer cylinder radius b (m)",1)
  b:=physv
  phys\ask("E at r (V/m, +outward)",0)
  ef:=physv
  phys\ask("Field radius r (m)",1)
  r:=physv
EndIf
If physok=0 Then
  Return
EndIf
Disp "GIVEN:"
If c=1 Then
  phys\out("  ra = "&phys\sn(ra)&" m")
  phys\out("  rb = "&phys\sn(rb)&" m")
  If ra≥rb Then
    Disp "Need ra < rb: inner sphere"
    Disp "  must fit inside outer."
    Return
  EndIf
  g:=(rb-ra)/(ra*rb)
  If s2=1 Then
    phys\out("  Vab = "&phys\sn(vab)&" V")
  Else
    phys\out("  q = "&phys\sn(q)&" C")
  EndIf
  Disp "STEP 1: Formula"
  Disp "  Vab = k*q*(1/ra-1/rb)"
  If s2=1 Then
    Disp "  q = Vab/[k*(1/ra-1/rb)]"
  EndIf
  Disp "STEP 2: Plug in"
  If s2=1 Then
    phys\pk({"q = ("&phys\sn(vab)&")","/[(8.99ᴇ9)","*("&phys\sn(g)&")]"})
    q:=vab/(kc*g)
  Else
    phys\pk({"Vab = (8.99ᴇ9)","*("&phys\sn(q)&")","*("&phys\sn(g)&")"})
    vab:=kc*q*g
  EndIf
  Disp "STEP 3: Answer"
  phys\out("  q = "&phys\sf(q)&" C")
  phys\out("  Vab = "&phys\sf(vab)&" V")
Else
  phys\out("  a = "&phys\sn(a)&" m")
  phys\out("  b = "&phys\sn(b)&" m")
  phys\out("  E = "&phys\sn(ef)&" V/m")
  phys\out("  r = "&phys\sn(r)&" m")
  If a≥b or r<a or r>b Then
    Disp "Need a < b, with E measured"
    Disp "  between a and b."
    Return
  EndIf
  er:=ef*r
  Disp "STEP 1: Formula"
  Disp "  Vab = E*r*ln(b/a)"
  Disp "  λ = 2π*ε0*E*r"
  Disp "STEP 2: Plug in"
  phys\pk({"Vab = ("&phys\sn(er)&")","*ln("&phys\sn(b)&"/"&phys\sn(a)&")"})
  phys\pk({"λ = 2π*(8.854ᴇ−12)","*("&phys\sn(er)&")"})
  vab:=approx(er*ln(b/a))
  lam:=approx(2*π*e0*er)
  Disp "STEP 3: Answer"
  phys\out("  Vab = "&phys\sf(vab)&" V")
  phys\out("  λ = "&phys\sf(lam)&" C/m")
EndIf
Disp "DIRECTION:"
If vab>0 Then
  Disp "  Inner is at higher V."
  Disp "  E points outward."
ElseIf vab<0 Then
  Disp "  Inner is at lower V."
  Disp "  E points inward."
Else
  Disp "  Equal V; no field between."
EndIf
EndPrgm

Define LibPriv m239()=
Prgm
Local q,rr,kc,dv
kc:=8.99ᴇ9
phys\hdr("23.9 Insulating sphere")
phys\ask("Total charge Q (C)",0)
q:=physv
phys\ask("Sphere radius R (m)",1)
rr:=physv
If physok=0 Then
  Return
EndIf
Disp "GIVEN:"
phys\out("  Q = "&phys\sn(q)&" C")
phys\out("  R = "&phys\sn(rr)&" m")
Disp "  Charge spread uniformly."
Disp "STEP 1: Formula"
Disp "  V(0)-V(R) = k*Q/(2R)"
Disp "  V(R) = k*Q/R"
Disp "  V(0) = 3*k*Q/(2R)"
Disp "STEP 2: Plug in"
phys\pk({"V(0)-V(R) = (8.99ᴇ9)","*("&phys\sn(q)&")","/(2*("&phys\sn(rr)&"))"})
dv:=kc*q/(2*rr)
Disp "STEP 3: Answer"
Disp "  V(center) - V(surface)"
phys\out("    = "&phys\sf(dv)&" V")
Disp "  V(surface)"
phys\out("    = "&phys\sf(2*dv)&" V")
Disp "  V(center)"
phys\out("    = "&phys\sf(3*dv)&" V")
Disp "DIRECTION:"
If q>0 Then
  Disp "  Center is at higher V."
ElseIf q<0 Then
  Disp "  Center is at lower V."
Else
  Disp "  No charge: V = 0."
EndIf
EndPrgm

Define LibPriv m2310()=
Prgm
Local q1,x1,q2,x2,q3,kv,x3,lo,hi,kc,u12,u13,u23,a0,a1,a2,bp,xa,xb,j,aa,bb,xm,s1,s2,rts,i,rt,kl,sc,ok,failed,keep
kc:=8.99ᴇ9
phys\hdr("23.10 Where U = 0")
Disp "q1, q2 fixed on the x-axis"
Disp "q3 moves along the x-axis"
phys\ask("q1 in C (E for x10^: 4E-9)",0)
q1:=physv
phys\ask("x1 in m",0)
x1:=physv
phys\ask("q2 in C",0)
q2:=physv
phys\ask("x2 in m",0)
x2:=physv
phys\ask("Movable charge q3 in C",0)
q3:=physv
phys\ask("Know q3 position now? 1=yes 0=no",201)
kv:=physv
If kv=1 Then
  phys\ask("x3 (q3 now) in m",0)
  x3:=physv
EndIf
phys\ask("Search from x = (m)",0)
lo:=physv
phys\ask("Search to x = (m)",0)
hi:=physv
If physok=0 Then
  Return
EndIf
Disp "GIVEN:"
phys\out("  q1 = "&phys\sn(q1)&" C")
phys\out("    at x1 = "&phys\sn(x1)&" m")
phys\out("  q2 = "&phys\sn(q2)&" C")
phys\out("    at x2 = "&phys\sn(x2)&" m")
phys\out("  q3 = "&phys\sn(q3)&" C")
phys\pk({"Search x: "&phys\sn(lo)," to "&phys\sn(hi)&" m"})
If kv=1 Then
  phys\out("  Now x3 = "&phys\sn(x3)&" m")
EndIf
If x1=x2 Then
  Disp "q1 and q2 at the same x:"
  Disp "  U12 infinite. Need x1≠x2."
  Return
EndIf
If lo≥hi Then
  Disp "Search start must be less"
  Disp "  than the end."
  Return
EndIf
Disp "STEP 1: Formula"
Disp "  U(x) = k*[q1*q2/|x2-x1|"
Disp "    +q1*q3/|x-x1|"
Disp "    +q2*q3/|x-x2|]"
Disp "  Find x where U(x) = 0."
Disp "STEP 2: Plug in"
u12:=kc*q1*q2/abs(x2-x1)
If kv=1 Then
  If x3=x1 or x3=x2 Then
    Disp "q3 sits on a charge:"
    Disp "  r = 0, U is infinite."
    Return
  EndIf
  u13:=kc*q1*q3/abs(x3-x1)
  u23:=kc*q2*q3/abs(x3-x2)
  phys\out("U WITH q3 AT x = "&phys\sn(x3))
  Disp "  U12 = kq1q2/|x2-x1|"
  phys\out("    = "&phys\sf(u12)&" J")
  Disp "  U13 = kq1q3/|x3-x1|"
  phys\out("    = "&phys\sf(u13)&" J")
  Disp "  U23 = kq2q3/|x3-x2|"
  phys\out("    = "&phys\sf(u23)&" J")
  phys\out("  U = sum = "&phys\sf(u12+u13+u23)&" J")
EndIf
a0:=q1*q2/abs(x2-x1)
a1:=q1*q3
a2:=q2*q3
Disp "  For U = 0, k cancels."
phys\out("  q1q2/|x2-x1| = "&phys\sf(a0))
phys\out("  q1q3 = "&phys\sf(a1))
phys\out("  q2q3 = "&phys\sf(a2))
If a1=0 and a2=0 Then
  Disp "STEP 3: Answer"
  If a0=0 Then
    Disp "  U = 0 for every allowed x"
  Else
    Disp "  U does not depend on x"
    Disp "  and is never 0"
  EndIf
  Disp "DIRECTION:"
  Disp "  Exclude x1 and x2."
  Return
EndIf
Disp "  Split at x1 and x2."
Disp "  Keep roots in each piece."
sc:=max(abs(a0),max(abs(a1),abs(a2)))
a0:=a0/sc
a1:=a1/sc
a2:=a2/sc
xa:=min(x1,x2)
xb:=max(x1,x2)
bp:={lo}
If xa>lo and xa<hi Then
  bp:=augment(bp,{xa})
EndIf
If xb>lo and xb<hi Then
  bp:=augment(bp,{xb})
EndIf
bp:=augment(bp,{hi})
kl:={}
failed:=0
DelVar phzx
For j,1,dim(bp)-1
  aa:=bp[j]
  bb:=bp[j+1]
  xm:=aa/2+bb/2
  s1:=sign(xm-x1)
  s2:=sign(xm-x2)
  phys\out("PIECE "&string(j)&":")
  phys\pk({"x from "&phys\sn(aa)," to "&phys\sn(bb)})
  ok:=1
  Try
    rts:=zeros(a0+a1/(s1*(phzx-x1))+a2/(s2*(phzx-x2)),phzx)
  Else
    ok:=0
    ClrErr
  EndTry
  If ok=1 Then
    If getType(rts)≠"LIST" Then
      ok:=0
    EndIf
  EndIf
  If ok=0 Then
    Disp "  CAS could not solve piece."
    failed:=1
    Cycle
  EndIf
  If dim(rts)=0 Then
    Disp "  no root in this piece"
  EndIf
  For i,1,dim(rts)
    rt:=approx(rts[i])
    If getType(rt)≠"NUM" Then
      Disp "  Root could not be checked."
      failed:=1
      Cycle
    EndIf
    keep:=0
    If rt≠x1 and rt≠x2 Then
      If rt>aa and rt<bb Then
        keep:=1
      ElseIf (rt=aa and aa=lo) or (rt=bb and bb=hi) Then
        keep:=1
      EndIf
    EndIf
    If keep=1 Then
      phys\out("  x = "&phys\sf(rt)&" m: KEEP")
      kl:=augment(kl,{rt})
    Else
      phys\out("  x = "&phys\sf(rt)&" m: reject")
      Disp "    (outside valid interval)"
    EndIf
  EndFor
EndFor
DelVar phzx
Disp "STEP 3: Answer"
If dim(kl)=0 Then
  If failed=0 Then
    Disp "  U is never 0 from"
    phys\pk({"x = "&phys\sn(lo)," to "&phys\sn(hi)&" m"})
  Else
    Disp "  No confirmed root found."
  EndIf
Else
  For i,1,dim(kl)
    phys\out("  U = 0 at x = "&phys\sf(kl[i])&" m")
  EndFor
EndIf
If failed=1 Then
  Disp "  Search is incomplete."
EndIf
Disp "DIRECTION:"
phys\out("  U is signed; add all pairs.")
Disp "  x1 and x2 are excluded."
EndPrgm

